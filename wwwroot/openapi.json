{
  "openapi": "3.1.0",
  "info": {
    "title": "Орбитальный форпост",
    "version": "1.0.0",
    "description": "Локальный учебный контракт. X-Game-Id выбирает партию, полученную через POST /api/demo/games."
  },
  "paths": {
    "/api/demo/games": {
      "post": {
        "summary": "Начать отдельную партию",
        "responses": {
          "200": {
            "description": "Новая партия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "parameters": [
          {
            "name": "scenario",
            "in": "query",
            "description": "Исходный набор. По умолчанию создаётся свободная партия. Остальные наборы включают подготовленную M01 и редакцию каталога 2.",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "briefing",
                "boundary",
                "shortage",
                "rations",
                "launch-transfer"
              ],
              "default": "free"
            }
          }
        ]
      }
    },
    "/api/demo/catalog-revision": {
      "post": {
        "summary": "Изменить условия M01 в каталоге выбранной партии",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Обновлённая миссия",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mission"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/missions": {
      "get": {
        "summary": "Получить миссии партии",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Каталог",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Mission"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/game": {
      "get": {
        "summary": "Получить запас, баланс и состояние рейсов",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "responses": {
          "200": {
            "description": "Состояние партии",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Game"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/expeditions": {
      "post": {
        "summary": "Подготовить экспедицию",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrepareRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Экспедиция подготовлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expedition"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Маршрут созданной экспедиции",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/expeditions/{id}": {
      "get": {
        "summary": "Получить снимок и журнал экспедиции",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          },
          {
            "$ref": "#/components/parameters/ExpeditionId"
          }
        ],
        "responses": {
          "200": {
            "description": "Карточка экспедиции",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expedition"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/expeditions/{id}/transitions": {
      "post": {
        "summary": "Запустить, завершить или отменить экспедицию",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          },
          {
            "$ref": "#/components/parameters/ExpeditionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransitionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Экспедиция обновлена",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expedition"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/api/expeditions/{id}/replacements": {
      "post": {
        "summary": "Атомарно заменить подготовленный рейс на согласованную редакцию каталога",
        "parameters": [
          {
            "$ref": "#/components/parameters/GameId"
          },
          {
            "$ref": "#/components/parameters/ExpeditionId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplacementRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Новый рейс связан с исходным. Старый рейс отменён.",
            "headers": {
              "Location": {
                "description": "Маршрут нового рейса",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Expedition"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "GameId": {
        "name": "X-Game-Id",
        "in": "header",
        "required": true,
        "description": "Идентификатор партии",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ExpeditionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Ошибка проверки входа, отсутствующий объект или конфликт состояния",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "PrepareRequest": {
        "type": "object",
        "required": [
          "missionId"
        ],
        "properties": {
          "missionId": {
            "type": "string",
            "minLength": 1,
            "examples": [
              "M01"
            ]
          }
        }
      },
      "TransitionRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "launch",
              "complete",
              "cancel"
            ]
          }
        }
      },
      "Quantities": {
        "type": "object",
        "required": [
          "fuel",
          "rations"
        ],
        "properties": {
          "fuel": {
            "type": "integer",
            "minimum": 0
          },
          "rations": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Inventory": {
        "type": "object",
        "required": [
          "onHand",
          "reserved",
          "available"
        ],
        "properties": {
          "onHand": {
            "$ref": "#/components/schemas/Quantities"
          },
          "reserved": {
            "$ref": "#/components/schemas/Quantities"
          },
          "available": {
            "$ref": "#/components/schemas/Quantities"
          }
        }
      },
      "Mission": {
        "type": "object",
        "required": [
          "id",
          "title",
          "rewardCredits",
          "cost",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rewardCredits": {
            "type": "integer",
            "minimum": 0
          },
          "cost": {
            "$ref": "#/components/schemas/Quantities"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Game": {
        "type": "object",
        "required": [
          "id",
          "credits",
          "inventory",
          "activeExpedition",
          "expeditions",
          "scenarioId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "credits": {
            "type": "integer",
            "minimum": 0
          },
          "inventory": {
            "$ref": "#/components/schemas/Inventory"
          },
          "activeExpedition": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ExpeditionSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "expeditions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpeditionSummary"
            }
          },
          "scenarioId": {
            "type": "string"
          }
        }
      },
      "ExpeditionSummary": {
        "type": "object",
        "required": [
          "id",
          "missionId",
          "status",
          "rewardCreditsSnapshot",
          "catalogRevision",
          "replacesExpeditionId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "missionId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "prepared",
              "inFlight",
              "completed",
              "cancelled"
            ]
          },
          "rewardCreditsSnapshot": {
            "type": "integer",
            "minimum": 0
          },
          "catalogRevision": {
            "type": "integer",
            "minimum": 1
          },
          "replacesExpeditionId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Expedition": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ExpeditionSummary"
          },
          {
            "type": "object",
            "required": [
              "cost",
              "createdAtUtc",
              "history"
            ],
            "properties": {
              "cost": {
                "$ref": "#/components/schemas/Quantities"
              },
              "createdAtUtc": {
                "type": "string",
                "format": "date-time"
              },
              "history": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/TransitionEvent"
                }
              }
            }
          }
        ]
      },
      "TransitionEvent": {
        "type": "object",
        "required": [
          "sequence",
          "fromStatus",
          "toStatus",
          "changedAtUtc"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "fromStatus": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "prepared",
                  "inFlight",
                  "completed",
                  "cancelled"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "toStatus": {
            "type": "string",
            "enum": [
              "prepared",
              "inFlight",
              "completed",
              "cancelled"
            ]
          },
          "changedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ReplacementRequest": {
        "type": "object",
        "required": [
          "expectedCatalogRevision"
        ],
        "properties": {
          "expectedCatalogRevision": {
            "type": "integer",
            "minimum": 1,
            "examples": [
              2
            ]
          }
        }
      }
    }
  }
}
